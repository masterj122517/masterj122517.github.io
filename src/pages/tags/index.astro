---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(([left], [right]) => left.localeCompare(right));
---

<BaseLayout title="Tags" description="Browse notes by topic.">
  <Header />
  <main class="page-shell">
    <header class="page-heading">
      <p class="eyebrow"><span class="accent">$</span> ls ~/tags</p>
      <h1>Tags</h1>
      <p class="muted">A compact index of recurring subjects.</p>
    </header>
    <section class="panel" aria-label="Tag index">
      <div class="tag-list">
        {tags.map(([tag, count]) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag} <span class="muted">({count})</span></a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tag-list { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
