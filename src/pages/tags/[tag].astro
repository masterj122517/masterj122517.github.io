---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <Header />
  <main class="page-shell">
    <header class="page-heading">
      <p class="eyebrow"><span class="accent">$</span> grep -rl #{tag} ~/posts</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} post{posts.length === 1 ? '' : 's'} in this topic.</p>
    </header>
    {posts.length > 0 ? (
      <section class="post-list" aria-label={`Posts tagged ${tag}`}>
        {posts.map((post) => <PostCard post={post} />)}
      </section>
    ) : <p class="panel">No posts use this tag.</p>}
  </main>
  <Footer />
</BaseLayout>
