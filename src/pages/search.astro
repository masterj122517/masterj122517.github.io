---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search MasterJ's blog posts.">
  <Header />
  <main class="page-shell">
    <header class="page-heading">
      <p class="eyebrow"><span class="accent">$</span> search ~/posts</p>
      <h1>Search</h1>
      <p class="muted">Filter the archive by title, description, tag, or category.</p>
    </header>
    <Search />
  </main>
  <Footer />
</BaseLayout>
