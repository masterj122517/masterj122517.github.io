---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = posts.map((post, index) => ({
  number: index + 1,
  slug: post.data.slug ?? post.slug,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  date: post.data.date.toISOString().slice(0, 10),
  url: `/blog/${post.data.slug ?? post.slug}/`,
}));
const sections = [
  { command: 'writings', label: 'Writings', description: 'Notes, ideas & life', url: '/posts/', number: '01' },
  { command: 'projects', label: 'Projects', description: 'Things I build', url: '/projects/', number: '02' },
  { command: 'resume', label: 'Resume', description: 'The person behind the prompt', url: '/resume/', number: '03' },
  { command: 'contact', label: 'Contact', description: 'Start a conversation', url: '/contact/', number: '04' },
];
---

<BaseLayout>
  <main class="terminal-home">
    <header class="home-header">
      <a href="/" class="home-brand"><span class="brand-mark">M_</span> masterj<span class="muted"> / lostland</span></a>
      <span class="system-label"><span class="status-light"></span> PERSONAL SYSTEM <span class="muted">/ v2.0</span></span>
    </header>

    <section class="terminal-window" aria-label="LostLand interactive terminal">
      <div class="window-bar">
        <span class="window-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>guest@lostland: ~</span>
        <span class="window-mode">LOCAL SESSION</span>
      </div>
      <div class="terminal-intro">
        <div class="boot-line"><span class="accent">[ OK ]</span> LostLand personal terminal <span class="muted">— browser edition</span></div>
        <div class="intro-heading">
          <div>
            <p class="eyebrow">A corner of the internet, made personal.</p>
            <h1>LOSTLAND<span class="title-cursor" aria-hidden="true">_</span></h1>
          </div>
          <span class="identity">MASTERJ'S<br />DIGITAL FIELD NOTES</span>
        </div>
        <p class="intro-copy">Thinking out loud. Building things. Figuring it out.<br /><span class="muted">Welcome to my little corner of the internet.</span></p>
        <div class="section-grid" aria-label="Explore the site">
          {sections.map(section => (
            <a href={section.url} class="section-link" data-command={section.command}>
              <span class="section-number">/{section.number}</span>
              <span class="section-name">{section.label}<span aria-hidden="true"> ↗</span></span>
              <span class="section-description">{section.description}</span>
              <span class="section-command">$ {section.command}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="session-divider"><span>INTERACTIVE SHELL</span><span class="muted">not a real shell · just a way to explore</span></div>
      <div id="terminal-output" class="terminal-output" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" aria-label="Command output">
        <div class="output-entry welcome-entry">
          <p><span class="accent">guest@lostland</span><span class="muted">:~$</span> welcome</p>
          <p>Make yourself at home. Type <span class="accent">help</span> to see what you can do.</p>
          <p class="muted">Or try <span class="accent">writings</span> — {posts.length} notes from my journey so far.</p>
          {entries[0] && <p class="latest-note"><span class="muted">latest →</span> <a href={entries[0].url}>{entries[0].title}</a><span class="muted latest-date"> {entries[0].date}</span></p>}
        </div>
      </div>
      <form id="terminal-form" class="terminal-prompt" autocomplete="off">
        <label for="command-input" class="prompt-label"><span>guest</span><span class="prompt-host">@lostland</span><span class="muted">:~</span><span class="prompt-dollar">$</span></label>
        <input id="command-input" name="command" type="text" aria-label="Terminal command" aria-describedby="keyboard-hint" placeholder="Type a command…" spellcheck="false" autocapitalize="off" enterkeyhint="send" />
        <button type="submit" aria-label="Run command">↵</button>
      </form>
      <noscript><p class="no-script">The interactive shell needs JavaScript. All pages are still available through the links above.</p></noscript>
      <div class="terminal-status"><span><span class="status-light"></span> READY FOR INPUT</span><span>UTF-8 <span class="status-separator">│</span> ~/lostland</span></div>
    </section>

    <div class="under-terminal">
      <p id="keyboard-hint"><kbd>Tab</kbd> autocomplete <span>·</span> <kbd>↑</kbd><kbd>↓</kbd> history <span>·</span> <kbd>Ctrl L</kbd> clear</p>
      <a href="/posts/">Prefer browsing? View all writings <span aria-hidden="true">→</span></a>
    </div>
    <footer class="home-footer"><span>© {new Date().getFullYear()} MasterJ <span class="muted">/ Stay curious.</span></span><div><a href="/about/">about</a><a href="https://github.com/masterj122517/" target="_blank" rel="noopener noreferrer">github ↗</a><a href="/contact/">contact</a></div></footer>
  </main>
  <script id="terminal-data" type="application/json" set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />
  <script>
    import '../scripts/terminal';
  </script>
</BaseLayout>

<style>
  .terminal-home { width: min(100% - 64px, 1120px); margin: 0 auto; }
  .home-header { height: 100px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .home-brand { text-decoration: none; font-size: 13px; color: var(--text); }
  .brand-mark { background: var(--accent); color: var(--bg); font-size: 15px; font-weight: 700; padding: 4px 7px; margin-right: 14px; }
  .system-label { display: flex; align-items: center; gap: 9px; letter-spacing: .08em; font-size: 10px; }
  .status-light { display: inline-block; background: var(--accent); width: 5px; height: 5px; box-shadow: 0 0 8px #b0ed8533; flex-shrink: 0; }
  .terminal-window { background: linear-gradient(135deg, #121b13, #0d140f 65%); border: 1px solid #3c5139; box-shadow: 0 24px 90px #0005, 0 0 70px #b0ed8503; }
  .window-bar { display: flex; justify-content: space-between; align-items: center; gap: 15px; height: 43px; border-bottom: 1px solid var(--border); background: #172019; color: var(--muted); padding: 0 22px; font-size: 11px; }
  .window-lights { display: flex; gap: 7px; }
  .window-lights i { width: 7px; height: 7px; border: 1px solid #6b8066; border-radius: 50%; }
  .window-lights i:first-child { background: #8eaa72; border-color: #8eaa72; }
  .window-mode { font-size: 9px; letter-spacing: .1em; }
  .terminal-intro { padding: 28px 40px 32px; }
  .boot-line { font-size: 11px; margin-bottom: 40px; }
  .intro-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .intro-heading .eyebrow { font-size: 10px; margin-bottom: 12px; color: var(--muted); }
  h1 { color: var(--accent); font-size: clamp(42px, 7.2vw, 84px); line-height: 1; letter-spacing: -.08em; font-weight: 700; margin: 0; text-shadow: 0 0 24px #b0ed8512; }
  .title-cursor { color: #d1f8b9; animation: cursor-blink 1.6s step-end infinite; }
  .identity { text-align: right; font-size: 10px; color: var(--muted); letter-spacing: .13em; line-height: 1.9; margin-bottom: 6px; }
  .intro-copy { font-size: 13px; margin: 25px 0 30px; line-height: 1.9; }
  .section-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); }
  .section-link { display: flex; flex-direction: column; text-decoration: none; padding: 18px 20px; border-right: 1px solid var(--border); transition: background .15s; }
  .section-link:last-child { border-right: 0; }
  .section-link:hover { background: #b0ed8508; }
  .section-number { color: var(--muted); font-size: 10px; margin-bottom: 12px; }
  .section-name { font-size: 16px; display: flex; align-items: center; justify-content: space-between; }
  .section-name span { font-size: 12px; opacity: .5; }
  .section-description { color: var(--muted); font-size: 10px; margin: 5px 0 20px; }
  .section-command { font-size: 10px; color: #b0c3a5; }
  .session-divider { display: flex; justify-content: space-between; gap: 15px; margin: 0 40px; border-top: 1px dashed var(--border); padding-top: 16px; font-size: 9px; letter-spacing: .1em; color: var(--accent); }
  .session-divider .muted { letter-spacing: 0; }
  .terminal-output { padding: 18px 40px 22px; min-height: 174px; max-height: 360px; overflow-y: auto; font-size: 12px; scrollbar-color: #41563b #101812; overflow-wrap: anywhere; }
  .terminal-output :global(.output-entry) { margin-bottom: 18px; }
  .terminal-output :global(.output-entry:last-child) { margin-bottom: 0; }
  .terminal-output :global(p) { margin: 3px 0; }
  .terminal-output :global(.output-command) { margin-bottom: 10px; color: #d6dfd5; }
  .terminal-output :global(.output-row) { display: flex; flex-wrap: wrap; gap: 8px 14px; margin: 7px 0; }
  .terminal-output :global(.output-row a) { text-decoration: none; }
  .terminal-output :global(.output-row a:hover) { text-decoration: underline; }
  .terminal-output :global(.output-number) { color: var(--muted); min-width: 20px; }
  .terminal-output :global(.output-note) { color: var(--muted); font-size: 11px; }
  .latest-note { margin-top: 15px !important; }
  .latest-date { font-size: 10px; }
  .terminal-prompt { display: flex; align-items: center; gap: 12px; margin: 0 24px 24px; border: 1px solid #41563b; background: #0a110b; padding: 13px 16px; }
  .terminal-prompt:focus-within { border-color: var(--accent); box-shadow: 0 0 0 1px #b0ed8510; }
  .prompt-label { color: var(--accent); font-size: 12px; white-space: nowrap; }
  .prompt-dollar { margin-left: 8px; }
  .terminal-prompt input { background: transparent; border: 0; outline: none; color: var(--accent); min-width: 0; flex: 1; font-size: 13px; padding: 0; }
  .terminal-prompt input::placeholder { color: #85947d; }
  .terminal-prompt button { border: 1px solid var(--border); background: var(--surface); color: var(--accent); padding: 1px 8px; line-height: 1.5; }
  .terminal-status { display: flex; justify-content: space-between; background: #1b281b; padding: 7px 22px; font-size: 9px; color: #acbfa1; letter-spacing: .06em; }
  .terminal-status > span:first-child { display: flex; align-items: center; gap: 8px; }
  .status-separator { padding: 0 10px; color: #53654b; }
  .under-terminal { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 20px 0 55px; font-size: 10px; color: var(--muted); }
  .under-terminal p { margin: 0; }
  .under-terminal p > span { margin: 0 8px; }
  .under-terminal a { color: var(--muted); text-decoration: none; }
  .under-terminal a:hover { color: var(--accent); }
  kbd { font: inherit; border: 1px solid var(--border); padding: 2px 4px; color: var(--text); margin-right: 4px; }
  .home-footer { display: flex; justify-content: space-between; gap: 20px; padding: 23px 0 30px; border-top: 1px solid var(--border); font-size: 10px; color: var(--text); }
  .home-footer div { display: flex; gap: 25px; }
  .home-footer a { color: var(--muted); text-decoration: none; }
  .no-script { padding: 0 24px; color: var(--muted); }
  @keyframes cursor-blink { 0%, 65% { opacity: 1; } 66%, 100% { opacity: 0; } }
  @media (max-width: 760px) {
    .terminal-home { width: calc(100% - 36px); }
    .home-header { height: 76px; }
    .system-label { font-size: 8px; }
    .system-label .muted { display: none; }
    .terminal-intro { padding: 24px; }
    .boot-line { margin-bottom: 30px; }
    .identity { display: none; }
    .section-grid { grid-template-columns: repeat(2, 1fr); }
    .section-link { padding: 16px; }
    .section-link:nth-child(2) { border-right: 0; }
    .section-link:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    .section-description { margin-bottom: 12px; }
    .session-divider { margin: 0 24px; }
    .terminal-output { padding: 18px 24px; }
    .under-terminal { flex-direction: column; align-items: flex-start; gap: 15px; margin-bottom: 35px; }
  }
  @media (max-width: 430px) {
    .home-brand { font-size: 11px; }
    .brand-mark { margin-right: 7px; }
    .system-label { letter-spacing: 0; gap: 5px; }
    .window-bar { padding: 0 14px; }
    .window-mode { display: none; }
    .window-bar { justify-content: flex-start; }
    .boot-line { font-size: 9px; }
    .intro-heading .eyebrow { font-size: 8px; letter-spacing: .05em; }
    .intro-copy { font-size: 11px; }
    .terminal-intro { padding: 20px; }
    .boot-line { margin-bottom: 22px; }
    .section-link { padding: 12px 14px; }
    .section-number, .section-description { display: none; }
    .section-name { font-size: 14px; }
    .section-command { margin-top: 8px; font-size: 9px; }
    .session-divider .muted { display: none; }
    .terminal-prompt { margin: 0 14px 18px; gap: 9px; padding: 12px; }
    .prompt-host { display: none; }
    .terminal-prompt input { font-size: 16px; }
    .latest-date { display: none; }
    .home-footer { flex-direction: column; gap: 12px; }
  }
  @media (min-width: 761px) and (max-height: 820px) {
    .home-header { height: 72px; }
    .terminal-intro { padding: 20px 32px; }
    .boot-line { margin-bottom: 20px; }
    h1 { font-size: 64px; }
    .intro-copy { margin: 16px 0 20px; }
    .section-link { padding: 12px 16px; }
    .section-number { margin-bottom: 6px; }
    .section-description { margin: 4px 0 8px; }
    .terminal-output { min-height: 140px; }
    .under-terminal { margin: 16px 0 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .title-cursor { animation: none; } }
</style>
