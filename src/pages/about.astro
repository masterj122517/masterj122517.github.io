---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About MasterJ and this blog.">
  <Header />
  <main class="page-shell">
    <article class="prose">
      <header class="page-heading">
        <p class="eyebrow"><span class="accent">$</span> cat ~/about.txt</p>
        <h1>About</h1>
      </header>
      <p>I am MasterJ, a Chinese college student interested in the AI industry.</p>
      <p>This is where I keep notes while learning: development tools and workflows, programming ideas, philosophy, and life.</p>
      <p>I use public projects and writing to make my thinking visible. Start with the <a href="/projects">projects</a>, read the <a href="/posts">posts</a>, or find my public work on <a href="https://github.com/masterj122517/">GitHub</a>.</p>
    </article>
  </main>
  <Footer />
</BaseLayout>
