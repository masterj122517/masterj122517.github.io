---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const slug = data.slug ?? post.slug;
const date = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-item">
  <div class="post-meta">
    <time datetime={data.date.toISOString()}>{date}</time>
    <span>·</span>
    <span>{data.category}</span>
  </div>
  <h2><a href={`/blog/${slug}`}>{data.title}</a></h2>
  {data.description && <p class="muted">{data.description}</p>}
  {data.tags.length > 0 && (
    <div class="post-tags" aria-label="Tags">
      {data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
    </div>
  )}
</article>
