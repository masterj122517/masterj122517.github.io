---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section class="search" aria-labelledby="search-label">
  <form id="search-form" action="/search" role="search">
    <label id="search-label" for="search-input">query</label>
    <div class="search-controls">
      <span class="accent" aria-hidden="true">$</span>
      <input id="search-input" name="q" type="search" autocomplete="off" placeholder="title, description, tag, or category" />
      <button class="button-link" type="submit">filter</button>
    </div>
  </form>

  <p id="search-status" class="muted" aria-live="polite">Showing all {posts.length} posts.</p>

  <div class="post-list" id="search-results">
    {posts.map((post) => {
      const searchText = [post.data.title, post.data.description, post.data.category, ...post.data.tags]
        .join(' ')
        .toLocaleLowerCase();
      const slug = post.data.slug ?? post.slug;

      return (
        <article class="post-item" data-search-item data-search-text={searchText}>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>·</span>
            <span>{post.data.category}</span>
          </div>
          <h2><a href={`/blog/${slug}`}>{post.data.title}</a></h2>
          {post.data.description && <p class="muted">{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="post-tags" aria-label="Tags">
              {post.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
            </div>
          )}
        </article>
      );
    })}
  </div>

  <p id="search-empty" class="panel" hidden>No posts matched that query. Try a title, tag, category, or a different word.</p>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#search-form');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));
  const status = document.querySelector<HTMLElement>('#search-status');
  const empty = document.querySelector<HTMLElement>('#search-empty');

  const filterPosts = () => {
    const query = input?.value.trim().toLocaleLowerCase() ?? '';
    let matches = 0;

    for (const item of items) {
      const match = !query || item.dataset.searchText?.includes(query);
      item.hidden = !match;
      if (match) matches += 1;
    }

    if (status) {
      status.textContent = query
        ? `${matches} post${matches === 1 ? '' : 's'} matched “${query}”.`
        : `Showing all ${items.length} posts.`;
    }
    if (empty) empty.hidden = matches !== 0;
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    filterPosts();
    const url = new URL(window.location.href);
    if (input?.value.trim()) url.searchParams.set('q', input.value.trim());
    else url.searchParams.delete('q');
    window.history.replaceState(null, '', url);
  });
  input?.addEventListener('input', filterPosts);
  if (input) input.value = new URLSearchParams(window.location.search).get('q') ?? '';
  filterPosts();
</script>

<style>
  .search-controls { display: flex; gap: 0.75rem; align-items: center; }
  .search input { min-width: 0; flex: 1; padding: 10px 12px; border: 1px solid var(--border); background: var(--surface); color: var(--text); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
</style>
